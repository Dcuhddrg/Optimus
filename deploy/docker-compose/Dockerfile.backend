FROM golang:1.23-alpine AS build

WORKDIR /app/server

COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/optimus-backend .

FROM alpine:3.20

WORKDIR /app

ENV TZ=Asia/Shanghai
RUN apk update && apk add --no-cache tzdata openntpd \
    && ln -sf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
    
COPY --from=build /out/optimus-backend ./optimus-backend
COPY server/config.yaml ./config.yaml
COPY server/config/casbin_model.conf ./config/casbin_model.conf

CMD ["./optimus-backend"]
